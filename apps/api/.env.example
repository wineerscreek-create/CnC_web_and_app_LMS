# ---------------------------------------------------------------- runtime
ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
INSTITUTION_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- PostgreSQL (Primary Application Database)
USE_POSTGRES=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cnc

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=false

# ---------------------------------------------------------------- JWT / sessions
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------- auth policy
EMAIL_VERIFICATION_ENABLED=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute
OTP_TTL_MINUTES=10
PUBLIC_SIGNUP_ENABLED=true
SELF_SIGNUP_ROLES=STUDENT

# ---------------------------------------------------------------- object storage (Amazon S3)
# STORAGE_DRIVER=s3 requires the four AWS values below. `local` keeps files on disk behind
# HMAC-signed expiring URLs so the app runs with no AWS account.
STORAGE_DRIVER=local
S3_BUCKET=eedi-lms-private
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900
LOCAL_STORAGE_ROOT=./.storage

# ---------------------------------------------------------------- AI
# AI_PROVIDER=mock|anthropic|openai|huggingface.
# When using anthropic, openai, or huggingface, set AI_API_KEY.
# `mock` uses a deterministic, evidence-grounded evaluation and domain synthesis engine.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
STT_PROVIDER=mock
STT_API_KEY=
AI_REQUIRE_EVIDENCE=true

# ---------------------------------------------------------------- email
# Set EMAIL_PROVIDER=smtp and configure the SMTP_* vars for real email delivery.
# For Gmail: create a Google App Password at https://myaccount.google.com/apppasswords
#            (requires 2FA enabled). Use the 16-character App Password as SMTP_PASSWORD.
#            Never use your regular Gmail password here.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
EMAIL_FROM=CnC LMS <your-email@gmail.com>
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------- push notifications
FCM_ENABLED=false
FCM_SERVER_KEY=

# ---------------------------------------------------------------- background worker
QUEUE_NAME=eedi:jobs
QUEUE_EAGER=false
JOB_MAX_ATTEMPTS=3
REPORT_ASYNC_ROW_THRESHOLD=500

# ---------------------------------------------------------------- business rules
ATTENDANCE_DEFAULTER_THRESHOLD=75
CERTIFICATE_MIN_ATTENDANCE=75
CERTIFICATE_MIN_AVG_SCORE=60
WEAK_STUDENT_THRESHOLD=50
EVALUATION_EDIT_WINDOW_HOURS=72
BULK_IMPORT_MAX_ROWS=5000
SCORING_VERSION=1.0.0
EEDI_TRAINER_WEIGHT=0.6
EEDI_AI_WEIGHT=0.4

# ---------------------------------------------------------------- dev helpers
ALLOW_DEV_ENDPOINTS=true
