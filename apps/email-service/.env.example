# ============================================================
#  CnC LMS – Email Service (Node.js / Nodemailer)
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Gmail SMTP (recommended: use a 16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=CnC LMS <your-gmail@gmail.com>

# Shared secret — FastAPI sends this in "Authorization: Bearer <key>"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SERVICE_API_KEY=replace-with-a-strong-random-secret

# Port this service listens on (Render uses PORT env var automatically)
PORT=3001

# Optional: set to "true" to skip real SMTP and log emails to console (dev only)
EMAIL_DRY_RUN=false

