# ============================================================
#  CnC LMS – Email Service (Node.js / Mailjet API)
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Email delivery provider
# mailjet = Mailjet Send API v3.1 (recommended for Render/cloud)
EMAIL_PROVIDER=mailjet

# Mailjet API credentials (from Mailjet → Account → API Key Management)
# Generate at: https://app.mailjet.com/account/api_keys
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# Sender address — MUST be verified in Mailjet (Sender Domains & Addresses)
EMAIL_FROM=winerscreek@gmail.com
EMAIL_FROM_NAME=Winners Creek

# Shared secret — FastAPI sends this in "Authorization: Bearer <key>"
# This is NOT the Mailjet API key — it is a separate shared secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SERVICE_API_KEY=replace-with-a-strong-random-secret

# Port this service listens on (Render injects PORT automatically)
PORT=3001

# Set to "true" to skip real delivery and log emails to console (local dev only)
EMAIL_DRY_RUN=false

# Node environment
NODE_ENV=production

# ---------------------------------------------------------------------------
# REMOVED — no longer needed after Mailjet migration:
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASSWORD
# ---------------------------------------------------------------------------
