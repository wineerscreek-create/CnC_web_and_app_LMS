# Next.js Web Frontend Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The FastAPI service that Next proxies /api/v1/* to (server-side only)
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional Supabase Public Client Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
