# Copy to .env and change these before deploying
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=480
STUDENT_TOKEN_EXPIRE_MINUTES=180
ENCRYPTION_KEY=
# Comma-separated retired encryption keys, only used during a rotation
# window (still decrypt old data; never used to encrypt new data). See
# app/security/encryption.py for the rotation procedure and
# POST /api/admin/system/reencrypt to actively migrate old data forward.
ENCRYPTION_KEY_PREVIOUS=
CORS_ORIGINS=http://localhost:5173
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=ChangeMe123!
ENV=development

# How long an ended quiz's data + its temp/session_<id>/ report files stay
# available before the scheduler auto-deletes them, in case the admin never
# clicks "Delete Session" or downloads the report. Default: 24 hours.
REPORT_RETENTION_MINUTES=1440
# How long a report ZIP sticks around *after* it's actually been downloaded,
# independent of the full-session retention above. Default: 10 minutes.
REPORT_POST_DOWNLOAD_GRACE_MINUTES=10
# Where per-quiz report ZIPs (and the optional crash-recovery backup) are
# written before download (auto-created).
TEMP_DIR=../temp

# --- WebSocket heartbeat ---
WS_PING_INTERVAL=25
WS_PING_TIMEOUT=20
HEARTBEAT_INTERVAL_SECONDS=15
# How long without a heartbeat before the admin Monitor page flags a
# student's row as "stale" (still shows online, but hasn't checked in).
STALE_AFTER_SECONDS=45

# --- Crash-recovery backup (optional, Option B from the original design
# discussion: encrypted snapshots for reliability, not a database) ---
ENABLE_CRASH_RECOVERY_BACKUP=true
BACKUP_INTERVAL_SECONDS=30
