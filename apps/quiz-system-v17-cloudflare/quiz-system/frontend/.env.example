# Optional. If set, QR codes / join links default to this URL instead of
# window.location.origin (useful as a fallback; you can also just paste the
# tunnel URL directly into the "Public Base URL" field inside the Share
# dialog at runtime -- that takes priority and needs no rebuild).
#
# LEFT COMMENTED OUT ON PURPOSE. start.bat/start-tunnel.bat auto-copy this
# file to frontend/.env on first run -- if this line were active, its
# example placeholder value would become the REAL default for every QR/link
# (a fake https://your-tunnel.trycloudflare.com that resolves to nothing,
# i.e. exactly a DNS_PROBE_FINISHED_NXDOMAIN error), silently overriding the
# correct window.location.origin fallback. Only uncomment this if you're
# building a production bundle for a fixed, known public URL (see the named
# Cloudflare Tunnel / DEPLOYMENT.md docs in README.md) -- for a quick
# tunnel, whose URL is random every run, leave this commented out and either
# open the admin panel through the tunnel URL itself, or paste it into the
# "Public Base URL" field in the Share dialog once per run.
# VITE_PUBLIC_APP_URL=https://your-tunnel.trycloudflare.com

# Optional, only needed for a SPLIT deployment where the frontend and
# backend are on two different origins (e.g. frontend on Vercel/a Render
# Static Site, backend on its own Render Web Service). Leave blank for
# local dev, Cloudflare Tunnel, or any same-origin deployment (Nginx, or
# the backend serving the built frontend itself) -- those all use a
# relative "/api" and same-origin Socket.IO, which just works. If set, no
# trailing slash: https://quiz-backend.onrender.com not .../ .
# See DEPLOYMENT.md.
VITE_API_BASE_URL=
